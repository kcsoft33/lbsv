# Copy to .env and edit. .env is git-ignored.

# Interface address to publish the hub on: your LAN IP or Tailscale IP (e.g. 100.x.y.z).
# Default 127.0.0.1 = only reachable from the hub box itself.
LBSV_BIND_IP=127.0.0.1
LBSV_PUBLISH_PORT=11444

# Admin passphrase for the web UI (min 8 chars). Usually leave this EMPTY: on first start the hub prints a
# one-time setup code (docker compose logs hub), and you choose the passphrase in the browser.
# If set here, it wins on every start. Change it later with: docker compose exec -it hub lbsv set-passphrase
LBSV_ADMIN_PASSPHRASE=

# Cookie Secure flag: auto (secure when request is HTTPS), 1, or 0.
LBSV_COOKIE_SECURE=auto
# Behind a TLS reverse proxy (HAProxy, Caddy): set to the proxy's IP/CIDR so the hub trusts its
# X-Forwarded-For / X-Forwarded-Proto (login throttling by real client IP, Secure cookies). See packages/hub/README.md.
LBSV_TRUST_PROXY=

# The address devices use to reach the hub, put into the one-line agent installers. Default: whatever
# address the browser used to open the Devices page. Set it if that differs (e.g. https://lbsv.example.net).
LBSV_PUBLIC_URL=

# 0 = the hub never contacts tab hosts to fetch favicons.
LBSV_FAVICONS=1

# Automatic backups into /data/backups (in the volume): every N hours (0 = off), keeping the newest K.
# Restore: docker compose stop hub && docker compose run --rm hub lbsv restore latest && docker compose start hub
LBSV_BACKUP_EVERY_HOURS=24
LBSV_BACKUP_KEEP=14

# Pin a release instead of :latest, e.g. ghcr.io/kcsoft33/lbsv:0.2.0
# LBSV_IMAGE=ghcr.io/kcsoft33/lbsv:latest
