{
  "name": "lbsv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted, local-only hub for projects, live tabs, terminals and ideas.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "lbsv": "packages/hub/bin/lbsv.js"
  },
  "scripts": {
    "dev": "concurrently -k -n hub,ui -c blue,magenta \"npm:dev:hub\" \"npm:dev:ui\"",
    "dev:hub": "node --watch-path=packages/hub/src --watch-path=packages/shared/src packages/hub/src/cli.ts serve",
    "dev:ui": "vite --config packages/ui/vite.config.ts",
    "build": "vite build --config packages/ui/vite.config.ts",
    "build:ext": "node scripts/build-ext.ts",
    "build:agent": "node scripts/build-agent.ts",
    "agent": "node packages/agent/src/cli.ts",
    "start": "node packages/hub/src/cli.ts serve",
    "hub": "node packages/hub/src/cli.ts",
    "test": "vitest run",
    "e2e": "node scripts/e2e-m0.ts",
    "e2e:m1": "node scripts/e2e-m1.ts",
    "e2e:m2": "node scripts/e2e-m2.ts",
    "e2e:m2b": "node scripts/e2e-m2b.ts",
    "e2e:m3": "node scripts/e2e-m3.ts",
    "typecheck": "tsc -p tsconfig.json",
    "e2e:install": "node scripts/e2e-m5-install.ts",
    "sign:firefox": "node scripts/sign-firefox.ts",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  },
  "license": "MIT",
  "author": "Kelly Connell (CnlSft)"
}
